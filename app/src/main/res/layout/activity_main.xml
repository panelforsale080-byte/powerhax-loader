<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/loader_background">

    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/loader_background"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="24dp"
            android:paddingEnd="16dp"
            android:paddingBottom="72dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/library_menu_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/menu_button"
                    android:contentDescription="Open libraries"
                    android:padding="13dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_menu"
                    app:tint="@color/loader_text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ASTRAL LOADER"
                        android:textColor="@color/loader_text_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:letterSpacing="0.16"
                        android:text="LIBRARY SELECTOR"
                        android:textColor="@color/loader_text_muted"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/loader_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/app_banner"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/circle"
                        android:clipToOutline="true"
                        android:contentDescription="Selected library logo"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/library_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="ASTRAL"
                            android:textColor="@color/loader_text_primary"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/library_game"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Call of Duty"
                            android:textColor="@color/loader_text_secondary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/library_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="v1.6.57"
                            android:textColor="@color/loader_text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/library_package"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:drawableStart="@drawable/ic_package"
                            android:drawablePadding="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="com.example.game"
                            android:textColor="@color/loader_text_muted"
                            android:textSize="8sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/library_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/status_pill"
                        android:paddingStart="10dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="7dp"
                        android:text="● Ready"
                        android:textColor="@color/loader_status_active"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/loader_border" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:letterSpacing="0.18"
                    android:text="PRECISION  /  PERFORMANCE  /  NO LIMITS"
                    android:textColor="@color/loader_text_muted"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/license_key_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="LICENSE KEY"
                    android:textColor="@color/loader_text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"
                    android:hint="Enter your license key..."
                    app:boxBackgroundColor="#10151D"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="#3B4856"
                    app:boxStrokeWidth="1dp"
                    app:endIconMode="password_toggle"
                    app:hintTextColor="@color/loader_text_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="15dp"
                        android:singleLine="true"
                        android:inputType="textPassword"
                        android:textColor="@color/loader_text_primary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/inject_method_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="METHOD 2 — tap here to cycle inject method"
                    android:textColor="@color/loader_text_secondary"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="INJECT LOG"
                    android:textColor="@color/loader_text_muted"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <ScrollView
                    android:id="@+id/inject_log_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="4dp"
                    android:background="#0A0E14"
                    android:fillViewport="true"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/inject_log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Waiting for inject…"
                        android:textColor="@color/loader_text_secondary"
                        android:textIsSelectable="true"
                        android:textSize="8sp" />
                </ScrollView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/login_button"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="13dp"
                    android:text="LOAD LIBRARY"
                    android:textColor="#10151D"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/loader_text_primary"
                    app:cornerRadius="27dp"
                    app:icon="@drawable/ic_arrow_right"
                    app:iconGravity="textStart"
                    app:iconTint="#10151D"
                    app:strokeWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/telegram_button"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="9dp"
                    android:text="TELEGRAM"
                    android:textColor="@color/loader_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="#10151D"
                    app:cornerRadius="23dp"
                    app:icon="@drawable/ic_telegram"
                    app:iconGravity="textStart"
                    app:iconTint="@color/loader_text_primary"
                    app:strokeColor="@color/loader_text_primary"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/loader_card"
                    android:gravity="center"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:padding="9dp">
                    <ImageView android:layout_width="19dp" android:layout_height="19dp" android:contentDescription="Fast" android:src="@drawable/ic_fast" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="FAST" android:textColor="@color/loader_text_primary" android:textSize="9sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Instant access" android:textColor="@color/loader_text_secondary" android:textSize="8sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/loader_card"
                    android:gravity="center"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:padding="9dp">
                    <ImageView android:layout_width="19dp" android:layout_height="19dp" android:contentDescription="Secure" android:src="@drawable/ic_secure" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="SECURE" android:textColor="@color/loader_text_primary" android:textSize="9sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Safe &amp; encrypted" android:textColor="@color/loader_text_secondary" android:textSize="8sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/loader_card"
                    android:gravity="center"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:padding="9dp">
                    <ImageView android:layout_width="19dp" android:layout_height="19dp" android:contentDescription="Support" android:src="@drawable/ic_support" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="SUPPORT" android:textColor="@color/loader_text_primary" android:textSize="9sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Reliable help 24/7" android:textColor="@color/loader_text_secondary" android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:background="@drawable/loader_card"
                android:gravity="center_vertical"
                android:minHeight="70dp"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="Help" android:src="@drawable/ic_help" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Need help?" android:textColor="@color/loader_text_primary" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Join our Telegram for support, updates and more." android:textColor="@color/loader_text_secondary" android:textSize="9sp" />
                </LinearLayout>
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="Open support" android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <Spinner android:id="@+id/my_spinner" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
            <Spinner android:id="@+id/delay_spinner" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
            <Spinner android:id="@+id/method_spinner" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
            <ProgressBar android:id="@+id/progressBar" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
            <RadioGroup android:id="@+id/radioGroup" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone">
                <RadioButton android:id="@+id/radio_auto" android:layout_width="1dp" android:layout_height="1dp" />
                <RadioButton android:id="@+id/radio_manual" android:layout_width="1dp" android:layout_height="1dp" />
            </RadioGroup>
            <TextView
                android:id="@+id/root_status"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/powered_by"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="@color/loader_background"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:text="Powered by: @Sovereign_astral"
        android:textColor="@color/loader_text_muted"
        android:textSize="9sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/drawer_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/loader_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/library_drawer"
        android:layout_width="316dp"
        android:layout_height="match_parent"
        android:background="@drawable/drawer_panel"
        android:elevation="16dp"
        android:translationX="-316dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="28dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <ImageView android:layout_width="42dp" android:layout_height="42dp" android:contentDescription="Libraries" android:src="@drawable/ic_library_mark" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="11dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIBRARIES" android:textColor="@color/loader_text_primary" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Choose a product to continue" android:textColor="@color/loader_text_muted" android:textSize="9sp" />
                </LinearLayout>
                <ImageButton android:id="@+id/drawer_close" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="Close libraries" android:padding="9dp" android:src="@drawable/ic_close" />
            </LinearLayout>

            <EditText
                android:id="@+id/library_search"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/search_box"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:hint="Search libraries..."
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/loader_text_primary"
                android:textColorHint="@color/loader_text_muted"
                android:textSize="11sp" />

            <TextView android:id="@+id/library_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="AVAILABLE LIBRARIES" android:textColor="@color/loader_text_muted" android:textSize="9sp" android:textStyle="bold" />

            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="9dp" android:layout_weight="1" android:scrollbars="none">
                <LinearLayout android:id="@+id/library_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </ScrollView>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:background="@color/loader_border" />

            <LinearLayout android:id="@+id/drawer_about" android:layout_width="match_parent" android:layout_height="42dp" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="About" android:src="@drawable/ic_about" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="About" android:textColor="@color/loader_text_secondary" android:textSize="11sp" android:textStyle="bold" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="Open about" android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
